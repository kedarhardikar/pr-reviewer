+# ===========================
+# PDF Utilities
+# ===========================
+def generate_pdf_hash(pdf_bytes):
+    """Generate SHA256 hash for PDF content"""
+    return hashlib.sha256(pdf_bytes).hexdigest()[:16]
+
+def save_pdf_file(pdf_bytes, filename):
+    """Save PDF bytes to file and return path"""
+    if not os.path.exists('saved_pdfs'):
+        os.makedirs('saved_pdfs')
+    
+    file_path = os.path.join('saved_pdfs', filename)
+    with open(file_path, 'wb') as f:
+        f.write(pdf_bytes)
+    return file_path
+
+# ===========================
+# Scoring System
+# ===========================
+def evaluate_answers(question_text, answer_text, metadata, llm):
+    """Use LLM to evaluate answers and provide scoring"""
+    
+    evaluation_prompt = f"""
+    You are an expert examiner. You need to evaluate student answers against the question paper.
+
+    QUESTION PAPER:
+    {question_text}
+
+    STUDENT ANSWERS:
+    {answer_text}
+
+    EVALUATION METADATA:
+    - Subject: {metadata.get('subject', 'General')}
+    - Format: {metadata.get('format', 'Mixed')}
+    - Total Questions: {metadata.get('num_questions', 'Unknown')}
+    - Marks per Question: {metadata.get('marks_per_question', 3)}
+
+    INSTRUCTIONS:
+    1. Extract and evaluate each answer systematically
+    2. For each question, determine the correct answer/expected points
+    3. Provide a score for each question (0 to marks_per_question)
+    4. Give feedback comparing student answer to correct answer
+    5. Calculate total score and percentage
+    6. Provide overall feedback and suggestions for improvement
+
+    OUTPUT FORMAT - RETURN ONLY VALID JSON:
+    {{
+        "question_scores": [
+            {{
+                "question_num": 1, 
+                "score": 2, 
+                "max_score": 3, 
+                "feedback": "Good attempt but missing key points",
+                "correct_answer": "For MCQ: 'B) Option B text' OR For Subjective: 'Key points: 1) Point 1, 2) Point 2, 3) Point 3'",
+                "student_answer": "Student's actual answer text"
+            }},
+            {{
+                "question_num": 2, 
+                "score": 3, 
+                "max_score": 3, 
+                "feedback": "Excellent answer, covers all aspects",
+                "correct_answer": "Expected answer/points here",
+                "student_answer": "Student's actual answer text"
+            }}
+        ],
+        "total_score": 15,
+        "total_possible": 30,
+        "percentage": 50.0,
+        "overall_feedback": "Overall performance feedback here",
+        "strengths": ["List of strengths"],
+        "improvements": ["Areas for improvement"],
+        "grade": "B"
+    }}
+
+    IMPORTANT GUIDELINES:
+    - For MCQ questions: "correct_answer" should be "A) Option text" format
+    - For Subjective questions: "correct_answer" should be "Key points: 1) Point 1, 2) Point 2..." format
+    - For Numerical questions: "correct_answer" should be "Final answer: [number] with steps: Step 1..., Step 2..."
+    - Always include the student's actual answer in "student_answer" field
+    - Be fair but thorough in evaluation
+    - Ensure all scores are realistic and justified
+    """
+
+    try:
+        response = llm.invoke(evaluation_prompt)
+        raw_output = response.content
+        
+        # Clean and parse JSON
+        cleaned_output = clean_llm_json(raw_output)
+        evaluation_result = json.loads(cleaned_output)
+        
+        return evaluation_result
+    except Exception as e:
+        print(f"Error in evaluation: {e}")
+        # Return default evaluation
+        return {
+            "question_scores": [{"question_num": i+1, "score": 0, "max_score": 3, "feedback": "Could not evaluate", "correct_answer": "Unable to determine", "student_answer": "Not readable"} 
+                              for i in range(metadata.get('num_questions', 5))],
+            "total_score": 0,
+            "total_possible": metadata.get('num_questions', 5) * 3,
+            "percentage": 0.0,
+            "overall_feedback": "Evaluation failed - please check answer format",
+            "strengths": ["N/A"],
+            "improvements": ["Please ensure answers are clearly written"],
+            "grade": "F"
+        }
+
+def create_result_pdf(evaluation_result, student_name, subject, hash_id):
+    """Create detailed result PDF with scores and feedback"""
+    buffer = io.BytesIO()
+    doc = SimpleDocTemplate(buffer, pagesize=letter, rightMargin=50, leftMargin=50, topMargin=50, bottomMargin=50)
+    
+    # Container for the 'Flowable' objects
+    elements = []
+    
+    # Define styles
+    styles = getSampleStyleSheet()
+    title_style = ParagraphStyle(
+        'CustomTitle',
+        parent=styles['Heading1'],
+        fontSize=18,
+        spaceAfter=30,
+        textColor=colors.darkblue,
+        alignment=1  # Center alignment
+    )
+    
+    heading_style = ParagraphStyle(
+        'CustomHeading',
+        parent=styles['Heading2'],
+        fontSize=14,
+        spaceAfter=12,
+        textColor=colors.darkgreen
+    )
+    
+    # Title
+    title = Paragraph("EVALUATION RESULT REPORT", title_style)
+    elements.append(title)
+    elements.append(Spacer(1, 20))
+    
+    # Student Information
+    info_data = [
+        ['Student/Paper Name:', student_name],
+        ['Subject:', subject],
+        ['Hash ID:', hash_id],
+        ['Date:', datetime.now().strftime('%Y-%m-%d %H:%M:%S')],
+        ['Total Score:', f"{evaluation_result['total_score']}/{evaluation_result['total_possible']}"],
+        ['Percentage:', f"{evaluation_result['percentage']:.1f}%"],
+        ['Grade:', evaluation_result['grade']]
+    ]
+    
+    info_table = Table(info_data, colWidths=[150, 300])
+    info_table.setStyle(TableStyle([
+        ('BACKGROUND', (0, 0), (0, -1), colors.lightgrey),
+        ('TEXTCOLOR', (0, 0), (-1, -1), colors.black),
+        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
+        ('FONTNAME', (0, 0), (-1, -1), 'Helvetica'),
+        ('FONTSIZE', (0, 0), (-1, -1), 10),
+        ('GRID', (0, 0), (-1, -1), 1, colors.black),
+        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
+    ]))
+    
+    elements.append(info_table)
+    elements.append(Spacer(1, 30))
+    
+    # Question-wise Scores
+    elements.append(Paragraph("QUESTION-WISE BREAKDOWN", heading_style))
+    elements.append(Spacer(1, 12))
+    
+    score_data = [['Q#', 'Score', 'Student Answer', 'Correct Answer/Points', 'Feedback']]
+    for q_score in evaluation_result['question_scores']:
+        # Truncate long text for table display
+        student_ans = q_score.get('student_answer', 'N/A')[:80] + "..." if len(q_score.get('student_answer', '')) > 80 else q_score.get('student_answer', 'N/A')
+        correct_ans = q_score.get('correct_answer', 'N/A')[:80] + "..." if len(q_score.get('correct_answer', '')) > 80 else q_score.get('correct_answer', 'N/A')
+        feedback = q_score['feedback'][:60] + "..." if len(q_score['feedback']) > 60 else q_score['feedback']
+        
+        score_data.append([
+            f"Q{q_score['question_num']}", 
+            f"{q_score['score']}/{q_score['max_score']}",
+            student_ans,
+            correct_ans,
+            feedback
+        ])
+    
+    score_table = Table(score_data, colWidths=[30, 40, 120, 120, 120])
+    score_table.setStyle(TableStyle([
+        ('BACKGROUND', (0, 0), (-1, 0), colors.darkblue),
+        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
+        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
+        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
+        ('FONTSIZE', (0, 0), (-1, 0), 9),
+        ('FONTNAME', (1, 1), (-1, -1), 'Helvetica'),
+        ('FONTSIZE', (1, 1), (-1, -1), 8),
+        ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
+        ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
+        ('GRID', (0, 0), (-1, -1), 1, colors.black),
+        ('VALIGN', (0, 0), (-1, -1), 'TOP'),
+    ]))
+    
+    elements.append(score_table)
+    elements.append(Spacer(1, 30))
+    
+    # Overall Feedback
+    elements.append(Paragraph("OVERALL FEEDBACK", heading_style))
+    feedback_para = Paragraph(evaluation_result['overall_feedback'], styles['Normal'])
+    elements.append(feedback_para)
+    elements.append(Spacer(1, 20))
+    
+    # Strengths
+    elements.append(Paragraph("STRENGTHS", heading_style))
+    strengths_text = "<br/>• ".join(evaluation_result['strengths'])
+    strengths_para = Paragraph(f"• {strengths_text}", styles['Normal'])
+    elements.append(strengths_para)
+    elements.append(Spacer(1, 20))
+    
+    # Areas for Improvement
+    elements.append(Paragraph("AREAS FOR IMPROVEMENT", heading_style))
+    improvements_text = "<br/>• ".join(evaluation_result['improvements'])
+    improvements_para = Paragraph(f"• {improvements_text}", styles['Normal'])
+    elements.append(improvements_para)
+    
+    # Build PDF
+    doc.build(elements)
+    buffer.seek(0)
+    return buffer
+
+# ===========================
+# Question Generator (Enhanced)
+# ===========================
+def generate_questions(user_query, llm):
+    # Step 1: Extract Metadata
+    extraction_prompt = """
+    You are a strict information extractor.
+    You will ONLY output a JSON object with the following schema:
+
+    {
+    "subject": "string",
+    "topics": ["string", ...],
+    "exam_level": "string",
+    "difficulty": "string",
+    "format": "string",                     // One of: MCQ, Subjective, Numerical, Mixed, FillBlanks, AssertionReason
+    "num_questions": integer,
+    "options_per_question": integer,        // required for MCQ, else can be null or omitted
+    "marks_per_question": integer,          // or null
+    "negative_marking": boolean
+    }
+
+    Constraints:
+    - Always return valid JSON ONLY (no extra text).
+    - If user input does not specify something, make a reasonable default guess.
+    - "format" MUST be one of the allowed values.
+    - "negative_marking" must be true/false.
+    - "topics" must always be an array.
+    - Do not invent irrelevant fields.
+    """
+
+    # Invoke LLM with plain string
+    extract_response = llm.invoke(extraction_prompt + "\nUser Query: " + user_query)
+    raw_output = extract_response.content
+
+    try:
+        cleaned_output = clean_llm_json(raw_output)
+        metadata = json.loads(cleaned_output)
+        print("Parsed Metadata:", metadata)
+    except Exception as e:
+        print("❌ JSON Parse Failed:", e)
+        metadata = {"subject": "General", "difficulty": "Easy", "num_questions": 10, "format": "MCQ"}
+
+    subject = metadata.get("subject", "General")
+    topics = metadata.get("topics", ["General"])
+    exam_level = metadata.get("exam_level", "General")
+    format = metadata.get("format", "MCQ")
+    options_per_question = metadata.get("options_per_question", 4)
+    marks_per_question = metadata.get("marks_per_question", 3)
+    negative_marking = metadata.get("negative_marking", False)
+    difficulty = metadata.get("difficulty", "Easy")
+    num_qs = metadata.get("num_questions", 10)
+
+    # Step 2: Generate Questions
+    question_prompt = f"""
+    You are a professional exam question paper generator.
+
+    Generate ONLY {num_qs} questions with the following constraints:
+
+    - Subject: {subject}
+    - Topics: {", ".join(topics)}
+    - Exam Level: {exam_level}
+    - Difficulty: {difficulty}
+    - Question Format: {format}
+    - Marks per Question: {marks_per_question if marks_per_question else "N/A"}
+    - Negative Marking: {"Yes" if negative_marking else "No"}
+
+    Rules:
+    - Number the questions as Q1, Q2, ... Q{num_qs}.
+    - If format = MCQ:
+        * Provide exactly {options_per_question} options (A, B, C, D, ...).
+        * Do NOT include answers, hints, or explanations.
+    - If format = Subjective, Numerical, FillBlanks, or AssertionReason:
+        * Write only the questions in that format.
+    - If format = Mixed:
+        * Include a balanced mix of MCQ, Subjective, Numerical, and FillBlanks.
+    - Keep questions clear, concise, and exam-appropriate.
+    - Output ONLY the questions (and options if applicable). Do NOT include solutions or commentary.
+    """
+    
+    question_response = llm.invoke(question_prompt)
+    questions_text = question_response.content
+
+    # Remove <think> blocks
+    questions_text = re.sub(r"<think>.*?</think>", "", questions_text, flags=re.DOTALL)
+
+    # Split into clean list
+    questions = [line.strip() for line in questions_text.split("\n") if line.strip()]
+    print("questions:", questions)
+
+    return questions, metadata
+
+# ===========================
+# PDF Generator (Enhanced)
+# ===========================
+def create_pdf(questions, metadata):
+    buffer = io.BytesIO()
+    c = canvas.Canvas(buffer, pagesize=letter)
+    width, height = letter
+
+    y = height - 50
+    c.setFont("Helvetica-Bold", 16)
+    c.drawString(50, y, "Generated Question Paper")
+    y -= 30
+    
+    # Add metadata
+    c.setFont("Helvetica", 10)
+    c.drawString(50, y, f"Subject: {metadata.get('subject', 'N/A')}")
+    y -= 15
+    c.drawString(50, y, f"Difficulty: {metadata.get('difficulty', 'N/A')}")
+    y -= 15
+    c.drawString(50, y, f"Format: {metadata.get('format', 'N/A')}")
+    y -= 15
