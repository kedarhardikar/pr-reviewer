+# ===========================
+# Database Setup
+# ===========================
+def init_database():
+    """Initialize SQLite database with required tables"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    
+    cursor.execute('''
+        CREATE TABLE IF NOT EXISTS question_papers (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            hash_id TEXT UNIQUE NOT NULL,
+            name TEXT NOT NULL,
+            subject TEXT,
+            difficulty TEXT,
+            num_questions INTEGER,
+            question_format TEXT,
+            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
+            question_pdf_path TEXT,
+            answer_pdf_path TEXT,
+            score REAL,
+            feedback_pdf_path TEXT,
+            detailed_feedback TEXT
+        )
+    ''')
+    
+    conn.commit()
+    conn.close()
+
+def save_to_database(hash_id, name, subject, difficulty, num_questions, question_format, pdf_path):
+    """Save question paper metadata to database"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    
+    try:
+        cursor.execute('''
+            INSERT INTO question_papers 
+            (hash_id, name, subject, difficulty, num_questions, question_format, question_pdf_path)
+            VALUES (?, ?, ?, ?, ?, ?, ?)
+        ''', (hash_id, name, subject, difficulty, num_questions, question_format, pdf_path))
+        
+        conn.commit()
+        return True
+    except sqlite3.IntegrityError:
+        return False  # Hash already exists
+    finally:
+        conn.close()
+
+def get_all_question_papers():
+    """Retrieve all question papers from database"""
+    conn = sqlite3.connect('question_papers.db')
+    df = pd.read_sql_query('''
+        SELECT hash_id, name, subject, difficulty, num_questions, 
+               question_format, created_at, question_pdf_path, answer_pdf_path, score, feedback_pdf_path, detailed_feedback
+        FROM question_papers 
+        ORDER BY created_at DESC
+    ''', conn)
+    conn.close()
+    return df
+
+def get_question_paper_by_hash(hash_id):
+    """Get specific question paper by hash_id"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    cursor.execute('SELECT * FROM question_papers WHERE hash_id = ?', (hash_id,))
+    result = cursor.fetchone()
+    conn.close()
+    return result
+
+def update_answer_info(hash_id, answer_pdf_path, score=None, feedback_pdf_path=None, detailed_feedback=None):
+    """Update answer sheet information in database"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    
+    cursor.execute('''
+        UPDATE question_papers 
+        SET answer_pdf_path = ?, score = ?, feedback_pdf_path = ?, detailed_feedback = ?
+        WHERE hash_id = ?
+    ''', (answer_pdf_path, score, feedback_pdf_path, detailed_feedback, hash_id))
+    
+    conn.commit()
+    conn.close()
+
+def delete_question_paper(hash_id):
+    """Delete question paper and associated files"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    
+    # Get file paths first
+    cursor.execute('SELECT question_pdf_path, answer_pdf_path, feedback_pdf_path FROM question_papers WHERE hash_id = ?', (hash_id,))
+    result = cursor.fetchone()
+    
+    if result:
+        # Delete files if they exist
+        for file_path in result:
+            if file_path and os.path.exists(file_path):
+                try:
+                    os.remove(file_path)
+                except Exception as e:
+                    print(f"Error deleting file {file_path}: {e}")
+        
+        # Delete database record
+        cursor.execute('DELETE FROM question_papers WHERE hash_id = ?', (hash_id,))
+        conn.commit()
+        conn.close()
+        return True
+    
+    conn.close()
+    return False
+
+def clear_answer_data(hash_id):
+    """Clear answer sheet data for re-upload"""
+    conn = sqlite3.connect('question_papers.db')
+    cursor = conn.cursor()
+    
+    # Get current answer file paths
+    cursor.execute('SELECT answer_pdf_path, feedback_pdf_path FROM question_papers WHERE hash_id = ?', (hash_id,))
+    result = cursor.fetchone()
+    
+    if result:
+        # Delete old files
+        for file_path in result:
+            if file_path and os.path.exists(file_path):
+                try:
+                    os.remove(file_path)
+                except Exception as e:
+                    print(f"Error deleting file {file_path}: {e}")
+        
+        # Clear database fields
+        cursor.execute('''
+            UPDATE question_papers 
+            SET answer_pdf_path = NULL, score = NULL, feedback_pdf_path = NULL, detailed_feedback = NULL
+            WHERE hash_id = ?
+        ''', (hash_id,))
+        
+        conn.commit()
+    
+    conn.close()
