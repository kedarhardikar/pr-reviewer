    def save_to_database(hash_id, name, subject, difficulty, num_questions, question_format, pdf_path):
        """Save question paper metadata to database"""
        conn = sqlite3.connect('question_papers.db')
        cursor = conn.cursor()
        try:
            cursor.execute('''
                INSERT INTO question_papers
                (hash_id, name, subject, difficulty, num_questions, question_format, question_pdf_path)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (hash_id, name, subject, difficulty, num_questions, question_format, pdf_path))
            conn.commit()
            return True
        except sqlite3.IntegrityError:
            return False  # Hash already exists
        finally:
            conn.close()
    ```
    
